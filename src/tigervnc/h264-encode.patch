+// noVNC resets the decoder context for this rectangle.
+static const uint32_t resetContextFlag = 1;
+
+static int clamp8(int value)
+{
+  if (value < 0)
+    return 0;
+  if (value > 255)
+    return 255;
+  return value;
+}
+
+// Packed little-endian BGRA to full-range BT.709 4:2:0. Width and
+// height are even. Chroma is the average of each 2x2 block.
+static void bgraToI420(const uint8_t* src, int srcStride,
+                       int width, int height,
+                       uint8_t* yPlane, uint8_t* uPlane, uint8_t* vPlane)
+{
+  int row, x;
+
+  for (row = 0; row < height; row += 2) {
+    const uint8_t* s0 = src + (size_t)row * srcStride;
+    const uint8_t* s1 = s0 + srcStride;
+    uint8_t* y0 = yPlane + (size_t)row * width;
+    uint8_t* y1 = y0 + width;
+    uint8_t* uRow = uPlane + (size_t)(row / 2) * (width / 2);
+    uint8_t* vRow = vPlane + (size_t)(row / 2) * (width / 2);
+
+    for (x = 0; x < width; x += 2) {
+      int b00 = s0[0], g00 = s0[1], r00 = s0[2];
+      int b01 = s0[4], g01 = s0[5], r01 = s0[6];
+      int b10 = s1[0], g10 = s1[1], r10 = s1[2];
+      int b11 = s1[4], g11 = s1[5], r11 = s1[6];
+      int r, g, b, cb, cr;
+
+      y0[0] = (54 * r00 + 183 * g00 + 19 * b00) >> 8;
+      y0[1] = (54 * r01 + 183 * g01 + 19 * b01) >> 8;
+      y1[0] = (54 * r10 + 183 * g10 + 19 * b10) >> 8;
+      y1[1] = (54 * r11 + 183 * g11 + 19 * b11) >> 8;
+
+      r = (r00 + r01 + r10 + r11) >> 2;
+      g = (g00 + g01 + g10 + g11) >> 2;
+      b = (b00 + b01 + b10 + b11) >> 2;
+      cb = ((-29 * r - 99 * g + 128 * b) >> 8) + 128;
+      cr = ((128 * r - 116 * g - 12 * b) >> 8) + 128;
+      *uRow++ = clamp8(cb);
+      *vRow++ = clamp8(cr);
+
+      s0 += 8;
+      s1 += 8;
+      y0 += 2;
+      y1 += 2;
+    }
+  }
+}
+
+H264Encoder::H264Encoder(SConnection* conn_)
+  : conn(conn_), encoder(nullptr), width(0), height(0), pts(0),
+    failed(false), sendReset(false)
+{
+}
+
+H264Encoder::~H264Encoder()
+{
+  if (encoder != nullptr)
+    x264_encoder_close((x264_t*)encoder);
+}
+
+bool H264Encoder::isSupported() const
+{
+  if (failed)
+    return false;
+  return conn->client.supportsEncoding(encodingH264);
+}
+
+bool H264Encoder::openEncoder(int frameWidth, int frameHeight)
+{
+  x264_param_t param;
+  x264_t* opened;
+  int threads;
+
+  // One thread per CPU, up to 4. Extra threads are sliced so a frame
+  // is returned immediately. The web client submits every slice of
+  // that picture as one sample.
+  threads = (int)std::thread::hardware_concurrency();
+  if (threads < 2)
+    threads = 1;
+  else if (threads > 4)
+    threads = 4;
+
+  if (x264_param_default_preset(&param, "ultrafast", "zerolatency") < 0) {
+    vlog.error("x264 preset ultrafast/zerolatency was rejected");
+    failed = true;
+    return false;
+  }
+
+  param.i_csp = X264_CSP_I420;
+  param.i_width = frameWidth;
+  param.i_height = frameHeight;
+  param.b_vfr_input = 0;
+  param.b_repeat_headers = 1;
+  param.b_annexb = 1;
+  param.b_aud = 0;
+  param.i_fps_num = 30;
+  param.i_fps_den = 1;
+  // TCP delivers every frame, so a keyframe is only needed to open
+  // the decoder. A keyframe in the middle of a scroll is a large hitch.
+  param.i_keyint_max = X264_KEYINT_MAX_INFINITE;
+  param.i_keyint_min = 1;
+  param.rc.i_rc_method = X264_RC_CRF;
+  param.rc.f_rf_constant = 18;
+  param.i_threads = threads;
+  param.b_sliced_threads = threads > 1;
+  param.b_deblocking_filter = 1;
+  param.vui.b_fullrange = 1;
+  param.vui.i_colorprim = 1;
+  param.vui.i_transfer = 1;
+  param.vui.i_colmatrix = 1;
+  param.i_log_level = X264_LOG_ERROR;
+
+  if (x264_param_apply_profile(&param, "baseline") < 0) {
+    vlog.error("x264 baseline profile was rejected");
+    failed = true;
+    return false;
+  }
+
+  // The profile step can put the rate control and thread count back.
+  param.i_keyint_max = X264_KEYINT_MAX_INFINITE;
+  param.i_keyint_min = 1;
+  param.rc.i_rc_method = X264_RC_CRF;
+  param.rc.f_rf_constant = 18;
+  param.i_threads = threads;
+  param.b_sliced_threads = threads > 1;
+  param.b_deblocking_filter = 1;
+
+  opened = x264_encoder_open(&param);
+  if (opened == nullptr) {
+    vlog.error("x264 could not open a %dx%d encoder", frameWidth, frameHeight);
+    failed = true;
+    return false;
+  }
+
+  if (encoder != nullptr)
+    x264_encoder_close((x264_t*)encoder);
+  encoder = opened;
+  width = frameWidth;
+  height = frameHeight;
+  pts = 0;
+  sendReset = true;
+  vlog.info("H.264 encoder %dx%d, %d thread(s)", frameWidth, frameHeight,
+            threads);
+  return true;
+}
+
+bool H264Encoder::encode(const PixelBuffer* pb, const core::Rect& rect,
+                         std::vector<uint8_t>* annexb, uint32_t* flags)
+{
+  int frameWidth, frameHeight, srcStride, ySize, cSize;
+  const uint8_t* src;
+  const uint8_t* bgra;
+  int bgraStride;
+  uint8_t* yPlane;
+  uint8_t* uPlane;
+  uint8_t* vPlane;
+  x264_picture_t picIn, picOut;
+  x264_nal_t* nals;
+  int nnal, size;
+  PixelFormat bgraPF(32, 24, false, true, 255, 255, 255, 16, 8, 0);
+
+  if (!isSupported())
+    return false;
+
+  frameWidth = rect.width();
+  frameHeight = rect.height();
+  if (frameWidth < 16 || frameHeight < 16 ||
+      (frameWidth & 1) || (frameHeight & 1))
+    return false;
+
+  if (encoder == nullptr || width != frameWidth || height != frameHeight) {
+    if (!openEncoder(frameWidth, frameHeight))
+      return false;
+  }
+
+  src = pb->getBuffer(rect, &srcStride);
+  if (pb->getPF() == bgraPF) {
+    bgra = src;
+    bgraStride = srcStride * (pb->getPF().bpp / 8);
+  } else {
+    packed.resize((size_t)frameWidth * frameHeight * 4);
+    bgraPF.bufferFromBuffer(packed.data(), pb->getPF(), src,
+                            frameWidth, frameHeight,
+                            frameWidth, srcStride);
+    bgra = packed.data();
+    bgraStride = frameWidth * 4;
+  }
+
+  ySize = frameWidth * frameHeight;
+  cSize = ySize / 4;
+  i420.resize((size_t)ySize + cSize + cSize);
+  yPlane = i420.data();
+  uPlane = yPlane + ySize;
+  vPlane = uPlane + cSize;
+  bgraToI420(bgra, bgraStride, frameWidth, frameHeight,
+             yPlane, uPlane, vPlane);
+
+  x264_picture_init(&picIn);
+  picIn.img.i_csp = X264_CSP_I420;
+  picIn.img.i_plane = 3;
+  picIn.img.plane[0] = yPlane;
+  picIn.img.plane[1] = uPlane;
+  picIn.img.plane[2] = vPlane;
+  picIn.img.i_stride[0] = frameWidth;
+  picIn.img.i_stride[1] = frameWidth / 2;
+  picIn.img.i_stride[2] = frameWidth / 2;
+  picIn.i_pts = pts++;
+  picIn.i_type = sendReset ? X264_TYPE_IDR : X264_TYPE_AUTO;
+
+  nals = nullptr;
+  nnal = 0;
+  size = x264_encoder_encode((x264_t*)encoder, &nals, &nnal,
+                             &picIn, &picOut);
+  if (size <= 0 || nals == nullptr)
+    return false;
+
+  annexb->assign(nals[0].p_payload, nals[0].p_payload + size);
+  *flags = sendReset ? resetContextFlag : 0;
+  sendReset = false;
+  return true;
+}
