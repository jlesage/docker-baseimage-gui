+
+    // Encode rect, which is the even-sized screen. flags receives
+    // resetContext (1) when this frame opens a new decoder context.
+    // Returns false when the update should use another encoding.
+    bool encode(const PixelBuffer* pb, const core::Rect& rect,
+                std::vector<uint8_t>* annexb, uint32_t* flags);
