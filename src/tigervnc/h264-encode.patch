+static unsigned long regionPixels(const core::Region& region)
+{
+  std::vector<core::Rect> rects;
+  std::vector<core::Rect>::const_iterator rect;
+  unsigned long area;
+
+  area = 0;
+  region.get_rects(&rects);
+  for (rect = rects.begin(); rect != rects.end(); ++rect)
+    area += (unsigned long)rect->width() * (unsigned long)rect->height();
+  return area;
+}
+
+static unsigned long long nowMs()
+{
+  struct timeval tv;
+
+  gettimeofday(&tv, nullptr);
+  return (unsigned long long)tv.tv_sec * 1000ull +
+         (unsigned long long)tv.tv_usec / 1000ull;
+}
+
+// Stay on H.264 briefly after a large change so the frames in one
+// scroll share a decoder context.
+static const unsigned long long H264HoldMs = 500;
+
+bool EncodeManager::h264Due(const core::Region& changed,
+                            const core::Region& copied,
+                            const PixelBuffer* pb)
+{
+  unsigned long motion, fbArea;
+  unsigned long long now;
+  int w, h;
+  bool large;
+
+  if (h264 == nullptr || pb == nullptr || !h264->isSupported()) {
+    h264Active = false;
+    return false;
+  }
+
+  w = pb->width() & ~1;
+  h = pb->height() & ~1;
+  if (w < 16 || h < 16)
+    return false;
+
+  // A cursor blink does not open a video frame. The cursor is drawn
+  // on top of the picture by its own rectangle.
+  if (changed.is_empty() && copied.is_empty())
+    return false;
+
+  motion = regionPixels(changed) + regionPixels(copied);
+  fbArea = (unsigned long)w * (unsigned long)h;
+  // About a fifth of the screen: a scroll or a dragged window.
+  // A menu or a caret stays on JPEG.
+  large = motion >= 64 * 1024 && motion * 5 >= fbArea;
+
+  now = nowMs();
+  if (large) {
+    if (!h264Active)
+      vlog.info("H.264 video for the moving screen");
+    h264Active = true;
+    h264UntilMs = now + H264HoldMs;
+    return true;
+  }
+
+  if (h264Active && now < h264UntilMs)
+    return true;
+
+  if (h264Active) {
+    h264Active = false;
+    vlog.info("H.264 video ended");
+  }
+  return false;
+}
+
+void EncodeManager::writeH264Rect(const core::Rect& rect,
+                                  const std::vector<uint8_t>& annexb,
+                                  uint32_t flags)
+{
+  rdr::OutStream* os;
+
+  os = conn->getOutStream();
+  conn->writer()->startRect(rect, encodingH264);
+  os->writeU32((uint32_t)annexb.size());
+  os->writeU32(flags);
+  if (!annexb.empty())
+    os->writeBytes(annexb.data(), annexb.size());
+  conn->writer()->endRect();
+
+  // The video frame is the settled picture. A JPEG refresh of the
+  // whole screen would stall the next click.
+  lossyRegion.assign_subtract(rect);
+  pendingRefreshRegion.assign_subtract(rect);
+}
