+  // One full-frame H.264 stream for a web client. noVNC keeps a
+  // decoder per rectangle position and size, so every frame uses the
+  // same screen rectangle. The bytes are Annex-B with the 8-byte
+  // header noVNC expects: uint32 length, uint32 flags.
+  class H264Encoder {
+  public:
+    H264Encoder(SConnection* conn);
+    ~H264Encoder();
+
