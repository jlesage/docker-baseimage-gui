--- a/common/rfb/viewer-cursor.h
+++ b/common/rfb/viewer-cursor.h
@@ -0,0 +1,28 @@
+#ifndef __RFB_VIEWER_CURSOR_H__
+#define __RFB_VIEWER_CURSOR_H__
+
+#include <stdint.h>
+
+namespace rfb {
+
+  // Last row of an RGBA cursor. Returns true when the row spells a
+  // cursor name this server understands. name receives a NUL-terminated
+  // string of at most nameCap-1 characters.
+  bool decodeViewerCursorName(const uint8_t* rgba, int w, int h,
+                              char* name, int nameCap);
+
+  // Drop that row. Returns false when the image has no name row.
+  // On success outW and outH describe what remains. outH is 0 when the
+  // image was only the name row, and out may be null in that case.
+  // Otherwise out must hold w*(h-1)*4 bytes.
+  bool stripViewerCursorNameRow(const uint8_t* rgba, int w, int h,
+                                uint8_t* out, int* outW, int* outH);
+
+  // A new cursor with the name row removed, or nullptr when the image
+  // has no name row. The caller owns the result.
+  class Cursor;
+  Cursor* viewerCursorWithoutNameRow(const Cursor& cursor);
+
+}
+
+#endif
--- a/common/rfb/viewer-cursor.cxx
+++ b/common/rfb/viewer-cursor.cxx
@@ -0,0 +1,168 @@
+#include "viewer-cursor.h"
+
+#include <string.h>
+
+#include <vector>
+
+#include "Cursor.h"
+
+namespace rfb {
+
+  static const char* cursorNames[] = {
+    "alias",
+    "all-scroll",
+    "auto",
+    "cell",
+    "col-resize",
+    "context-menu",
+    "copy",
+    "crosshair",
+    "default",
+    "e-resize",
+    "ew-resize",
+    "grab",
+    "grabbing",
+    "help",
+    "move",
+    "n-resize",
+    "ne-resize",
+    "nesw-resize",
+    "no-drop",
+    "none",
+    "not-allowed",
+    "ns-resize",
+    "nw-resize",
+    "nwse-resize",
+    "pointer",
+    "progress",
+    "row-resize",
+    "s-resize",
+    "se-resize",
+    "sw-resize",
+    "text",
+    "vertical-text",
+    "w-resize",
+    "wait",
+    "zoom-in",
+    "zoom-out",
+  };
+
+  static const int cursorNameCount =
+    (int)(sizeof(cursorNames) / sizeof(cursorNames[0]));
+
+  static bool knownName(const char* name)
+  {
+    int lo = 0;
+    int hi = cursorNameCount - 1;
+    while (lo <= hi) {
+      int mid = (lo + hi) / 2;
+      int cmp = strcmp(name, cursorNames[mid]);
+      if (cmp == 0)
+        return true;
+      if (cmp < 0)
+        hi = mid - 1;
+      else
+        lo = mid + 1;
+    }
+    return false;
+  }
+
+  static bool opaqueByte(const uint8_t* p, uint8_t value)
+  {
+    return p[0] == value && p[1] == 0 && p[2] == 0 && p[3] == 255;
+  }
+
+  bool decodeViewerCursorName(const uint8_t* rgba, int w, int h,
+                              char* name, int nameCap)
+  {
+    if (rgba == nullptr || name == nullptr || nameCap < 2)
+      return false;
+    if (h < 1 || w < 5)
+      return false;
+
+    const uint8_t* row = rgba + (size_t)(h - 1) * (size_t)w * 4;
+    static const uint8_t magic[4] = { 'V', 'C', 'U', 'R' };
+    for (int i = 0; i < 4; i++) {
+      if (!opaqueByte(row + i * 4, magic[i]))
+        return false;
+    }
+    if (!opaqueByte(row + 4 * 4, 1))
+      return false;
+
+    int n = 0;
+    for (int x = 5; x < w; x++) {
+      const uint8_t* p = row + x * 4;
+      if (p[0] == 0 && p[1] == 0 && p[2] == 0 && p[3] == 0) {
+        for (int x2 = x; x2 < w; x2++) {
+          const uint8_t* q = row + x2 * 4;
+          if (q[0] != 0 || q[1] != 0 || q[2] != 0 || q[3] != 0)
+            return false;
+        }
+        break;
+      }
+      if (p[1] != 0 || p[2] != 0 || p[3] != 255 || p[0] < 0x20 || p[0] > 0x7e)
+        return false;
+      if (n + 1 >= nameCap)
+        return false;
+      name[n++] = (char)p[0];
+    }
+    name[n] = '\0';
+    return knownName(name);
+  }
+
+  bool stripViewerCursorNameRow(const uint8_t* rgba, int w, int h,
+                                uint8_t* out, int* outW, int* outH)
+  {
+    char name[32];
+    if (!decodeViewerCursorName(rgba, w, h, name, (int)sizeof(name)))
+      return false;
+    if (outW == nullptr || outH == nullptr)
+      return false;
+    if (h <= 1) {
+      *outW = 0;
+      *outH = 0;
+      return true;
+    }
+    if (out == nullptr)
+      return false;
+    size_t nbytes = (size_t)w * (size_t)(h - 1) * 4;
+    memcpy(out, rgba, nbytes);
+    *outW = w;
+    *outH = h - 1;
+    return true;
+  }
+
+  Cursor* viewerCursorWithoutNameRow(const Cursor& stored)
+  {
+    int w = stored.width();
+    int h = stored.height();
+    int sw = 0;
+    int sh = 0;
+    std::vector<uint8_t> buf;
+
+    if (h > 1)
+      buf.resize((size_t)w * (size_t)(h - 1) * 4);
+    if (!stripViewerCursorNameRow(stored.getBuffer(), w, h,
+                                  buf.empty() ? nullptr : buf.data(),
+                                  &sw, &sh))
+      return nullptr;
+    if (sh == 0) {
+      static const uint8_t dummy = 0;
+      return new Cursor(0, 0, core::Point(0, 0), &dummy);
+    }
+
+    core::Point hot = stored.hotspot();
+    if (hot.x < 0)
+      hot.x = 0;
+    if (hot.y < 0)
+      hot.y = 0;
+    if (hot.x >= sw)
+      hot.x = sw - 1;
+    if (hot.y >= sh)
+      hot.y = sh - 1;
+    Cursor* stripped = new Cursor(sw, sh, hot, buf.data());
+    stripped->crop();
+    return stripped;
+  }
+
+}
