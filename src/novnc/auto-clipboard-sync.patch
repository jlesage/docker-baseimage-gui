+    async _initClipboardAutoSyncState() {
+        if (!this._clipboardAutoSyncEnabled) {
+            return;
+        }
+
+        // Already initialized.
+        if (this._clipboardAutoSyncWritePerm && this._clipboardAutoSyncReadPerm) {
+            this._updateClipboardAutoSyncState();
+            return;
+        }
+
+        if (!(await RFB.isClipboardAutoSyncSupported())) {
+            Log.Info("clipboard auto sync not supported by browser");
+            return;
+        }
+
+        try {
+            const writePerm = await navigator.permissions.query(
+                {name: "clipboard-write", allowWithoutGesture: false});
+            const readPerm = await navigator.permissions.query(
+                {name: "clipboard-read", allowWithoutGesture: false});
+
+            Log.Info(`clipboard-write permission status is ${writePerm.state}`);
+            Log.Info(`clipboard-read permission status is ${readPerm.state}`);
+
+            // Feature may have been disabled while awaiting permission queries.
+            if (!this._clipboardAutoSyncEnabled) {
+                return;
+            }
+
+            writePerm.onchange = () => {
+                Log.Info(`clipboard-write permission status changed to ${writePerm.state}`);
+                this._updateClipboardAutoSyncState();
+            }
+            readPerm.onchange = () => {
+                Log.Info(`clipboard-read permission status changed to ${readPerm.state}.`);
+                this._updateClipboardAutoSyncState();
+            }
+
+            this._clipboardAutoSyncWritePerm = writePerm;
+            this._clipboardAutoSyncReadPerm = readPerm;
+            this._updateClipboardAutoSyncState();
+        } catch (error) {
+            Log.Info("clipboard auto sync not supported by browser: ", error);
+        }
+    }
