diff -ruN a/core/util/cursor-keyword.js b/core/util/cursor-keyword.js
--- a/core/util/cursor-keyword.js	1970-01-01 00:00:00.000000000 +0000
+++ b/core/util/cursor-keyword.js	2026-10-31 02:02:55.029332412 +0000
@@ -0,0 +1,95 @@
+/*
+ * Cursor name carried in the last row of a cursor image.
+ *
+ * The web viewer reads the name and sets the browser cursor. A client
+ * that did not ask for this support never sees the row: this server
+ * removes it before sending the picture.
+ */
+
+const CURSOR_NAMES = new Set([
+    "auto",
+    "default",
+    "none",
+    "context-menu",
+    "help",
+    "pointer",
+    "progress",
+    "wait",
+    "cell",
+    "crosshair",
+    "text",
+    "vertical-text",
+    "alias",
+    "copy",
+    "move",
+    "no-drop",
+    "not-allowed",
+    "grab",
+    "grabbing",
+    "e-resize",
+    "n-resize",
+    "ne-resize",
+    "nw-resize",
+    "s-resize",
+    "se-resize",
+    "sw-resize",
+    "w-resize",
+    "ew-resize",
+    "ns-resize",
+    "nesw-resize",
+    "nwse-resize",
+    "col-resize",
+    "row-resize",
+    "all-scroll",
+    "zoom-in",
+    "zoom-out",
+]);
+
+const MAGIC = [0x56, 0x43, 0x55, 0x52]; // VCUR
+const VERSION = 1;
+
+// rgba is a sequence of bytes, R G B A. Returns the cursor name, or null.
+export function decodeCursorKeyword(rgba, w, h) {
+    if (h < 1 || w < 5) {
+        return null;
+    }
+    const row = (h - 1) * w * 4;
+    for (let i = 0; i < 4; i++) {
+        const o = row + i * 4;
+        if (rgba[o] !== MAGIC[i] || rgba[o + 1] !== 0 ||
+            rgba[o + 2] !== 0 || rgba[o + 3] !== 255) {
+            return null;
+        }
+    }
+    const ver = row + 4 * 4;
+    if (rgba[ver] !== VERSION || rgba[ver + 1] !== 0 ||
+        rgba[ver + 2] !== 0 || rgba[ver + 3] !== 255) {
+        return null;
+    }
+    let name = "";
+    for (let x = 5; x < w; x++) {
+        const o = row + x * 4;
+        const r = rgba[o];
+        const g = rgba[o + 1];
+        const b = rgba[o + 2];
+        const a = rgba[o + 3];
+        if (r === 0 && g === 0 && b === 0 && a === 0) {
+            for (let x2 = x; x2 < w; x2++) {
+                const o2 = row + x2 * 4;
+                if (rgba[o2] !== 0 || rgba[o2 + 1] !== 0 ||
+                    rgba[o2 + 2] !== 0 || rgba[o2 + 3] !== 0) {
+                    return null;
+                }
+            }
+            break;
+        }
+        if (g !== 0 || b !== 0 || a !== 255 || r < 0x20 || r > 0x7e) {
+            return null;
+        }
+        name += String.fromCharCode(r);
+    }
+    if (!CURSOR_NAMES.has(name)) {
+        return null;
+    }
+    return name;
+}
